<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- HttpContext (UserService) lives in the ASP.NET Core shared framework; reference it
       instead of the legacy Microsoft.AspNetCore.Http.Abstractions package. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Microsoft.Extensions.Caching/Configuration.Abstractions are provided by the
       Microsoft.AspNetCore.App shared framework referenced above (NU1510). -->
  <ItemGroup>
    <PackageReference Include="JWT" />
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Data\DemoModels\DemoModels.csproj" />
    <ProjectReference Include="..\..\Data\DemoRepository\DemoRepository.csproj" />
    <ProjectReference Include="..\DemoUtilities\DemoUtilities.csproj" />
  </ItemGroup>

</Project>
