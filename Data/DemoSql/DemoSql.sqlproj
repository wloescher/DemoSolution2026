<Project Sdk="Microsoft.Build.Sql/2.2.0">

  <PropertyGroup>
    <Name>DemoSql</Name>
    <RootNamespace>DemoSql</RootNamespace>
    <AssemblyName>DemoSql</AssemblyName>
    <!-- SQL Server 2025 -->
    <DSP>Microsoft.Data.Tools.Schema.Sql.Sql170DatabaseSchemaProvider</DSP>
    <ModelCollation>1033, CI</ModelCollation>
  </PropertyGroup>

  <!-- The Microsoft.Build.Sql SDK globs **/*.sql as schema (Build) objects. All schema lives
       under Tables/ and Views/; the root-level *.sql files are seed / test-data scripts (INSERTs),
       so exclude them from the build model and keep them in the project as plain content. -->
  <ItemGroup>
    <Build Remove="*.sql" />
    <None Include="*.sql" />
    <None Include="demosolution-test-data.json" />
  </ItemGroup>

</Project>
